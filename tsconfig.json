{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    // TODO: remove in future
    "noImplicitAny": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false, // Ignore unused variables at the local scope
    "noUnusedParameters": false, // Ignore unused function parameters
    "noFallthroughCasesInSwitch": true,
    "types": ["jsdom", "vitest/globals"]
  },
  "include": ["assets_source"]
}
